{
  "name": "hotel-page-decisions-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "lint": "oxlint --ignore-pattern src/routeTree.gen.ts src scripts tests *.ts *.mjs && pnpm lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "oxfmt --write src scripts tests *.ts *.mjs *.json .oxlintrc.json README.md docs/*.md",
    "format:check": "oxfmt --check src scripts tests *.ts *.mjs *.json .oxlintrc.json README.md docs/*.md",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "perf:audit": "pnpm build && node scripts/audit-performance.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "oxnode scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.166.0",
    "@tanstack/react-start": "^1.166.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.0",
    "es-toolkit": "^1.52.0",
    "h3-compression": "^1.1.0",
    "ipx": "^3.1.1",
    "neverthrow": "^8.2.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.3",
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  }
}
